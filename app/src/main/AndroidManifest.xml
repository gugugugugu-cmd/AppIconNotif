<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 添加查询所有应用权限，解决 Android 11+ 包可见性问题 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主界面 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            libxposed API 102 模块声明不再使用 manifest meta-data，
            入口类 / 作用域 / API 版本统一声明在 META-INF/xposed/ 目录：
              - java_init.list  模块入口类
              - module.prop     API 版本与静态作用域开关
              - scope.list      静态作用域（com.android.systemui）
            io.github.libxposed:service 库会通过 manifest merger 自动注入
            ${applicationId}.XposedService ContentProvider，无需手动声明。
        -->
    </application>
</manifest>
